[Unit]
Description=Despierta al vigía DCAM cada 30 min (lee 10:00, 15:00 y 20:00; reintenta si gob.mx falla)

[Timer]
# vigia.py decide si lee: ranura pendiente o falla abierta. Si no, sale sin tocar la red.
OnCalendar=*-*-* *:00,30:00
Persistent=true
Unit=dcam-vigia.service

[Install]
WantedBy=timers.target
