[Unit]
Description=Vigía DCAM (gob.mx → Telegram) — corrida única
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=saulo
Group=saulo
WorkingDirectory=/home/saulo/apps/dcam-bot/repo
Environment=PYTHONPATH=/home/saulo/apps/quiron/lib
Environment=DCAM_DIR=/home/saulo/apps/dcam-bot
Environment=DCAM_TG_ENV=/home/saulo/apps/dcam-bot/telegram.env
# El guion inicial «-»: si no hay red para el pull, corre igual con el código que ya tiene
# (y si tampoco hay red para gob.mx, el propio vigía avisa que está roto).
ExecStartPre=-/usr/bin/flock -n /home/saulo/apps/dcam-bot/conciliar.lock /usr/bin/git -C /home/saulo/apps/dcam-bot/repo switch --force main --quiet
ExecStartPre=-/usr/bin/flock -n /home/saulo/apps/dcam-bot/conciliar.lock /usr/bin/git -C /home/saulo/apps/dcam-bot/repo pull --ff-only origin main --quiet
ExecStart=/usr/bin/python3 scripts/dcam/vigia.py
Nice=10
# Una corrida colgada no debe bloquear el disparo del timer del día siguiente;
# 3 h cubren la espera del preview y de producción más claude -p en la revisión de lo dudoso.
TimeoutStartSec=3h
