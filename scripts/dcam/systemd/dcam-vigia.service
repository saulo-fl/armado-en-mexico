[Unit]
Description=Vigía DCAM (gob.mx → Telegram) — corrida única
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=saulo
Group=saulo
WorkingDirectory=/home/saulo/apps/dcam-bot/repo
Environment=PYTHONPATH=/home/saulo/apps/quiron/lib
Environment=DCAM_DIR=/home/saulo/apps/dcam-bot
Environment=DCAM_TG_ENV=/home/saulo/apps/dcam-bot/telegram.env
ExecStart=/bin/sh scripts/dcam/correr.sh
Nice=10
# Una corrida colgada no debe bloquear el disparo del timer del día siguiente;
# 3 h cubren la espera del preview y de producción más claude -p en la revisión de lo dudoso.
TimeoutStartSec=3h
