{%- comment -%}
  ========================================================================
  ARMADO EN MÉXICO — Sección Shopify (Liquid) · v2
  ========================================================================
  Catálogo divulgativo de armas de fuego para tema Shopify.
  Compatible con tema vintage y Online Store 2.0.

  v2 · Cambios:
    • Fondo blanco automático en cards con foto real (clase .has-photo)
    • SEO: JSON-LD con Organization, WebPage, BreadcrumbList, FAQPage
    • CTA WhatsApp reescrito: 'asesores, no gestores'
    • Settings adicionales: título, disclaimer y texto del botón configurables

  Instalación:
    1. Sube este archivo a: sections/armado-en-mexico.liquid
    2. (Opcional) Crea metaobject 'armado_arma' con campos:
       - nombre, marca, tipo, pais, calibre, capacidad, peso, longitud
       - mecanismo, anio (number), era, avail, avail_label
       - legal_titulo, legal_desc, historia (multi-line text)
       - precio_exacto, precio_nivel (number 1-5)
       - imagen (file), dcam_ref
       - stats (json: { alcance, precision, retroceso, capacidad, manejo, poder })
       - disponibilidad (json array), uses (json array)
    3. O más rápido: en data_source elige 'JSON manual' y pega el
       contenido de 'shopify/armado-en-mexico.catalog.json' en el campo
       'Catálogo JSON'.
    4. En el customizer, añade la sección a la página deseada y configura
       el WhatsApp del abogado y los textos de asesoría.

  Diseño: oscuro táctico + Oswald/JetBrains Mono.
  ========================================================================
{%- endcomment -%}

{%- liquid
  assign sec_id = section.id
  assign accent = section.settings.color_accent | default: '#c9a227'
  assign bg = section.settings.color_bg | default: '#0d0f0c'
  assign wa_phone = section.settings.whatsapp_phone | default: '525555555555'
  assign wa_msg = section.settings.whatsapp_message | default: 'Hola, tengo una duda sobre la Ley Federal de Armas de Fuego'
-%}

{%- comment -%} ============ SEO: JSON-LD estructurado ============ {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "{{ shop.url }}/#org",
      "name": {{ shop.name | json }},
      "url": "{{ shop.url }}",
      "areaServed": "MX",
      "description": "Asesoría informativa sobre adquisición legal de armas de fuego en México conforme a la Ley Federal de Armas de Fuego y Explosivos."
    },
    {
      "@type": "WebPage",
      "@id": "{{ canonical_url }}#page",
      "url": "{{ canonical_url }}",
      "name": {{ page_title | default: 'Armado en México' | json }},
      "inLanguage": "es-MX",
      "isPartOf": { "@id": "{{ shop.url }}/#org" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "{{ shop.url }}" },
        { "@type": "ListItem", "position": 2, "name": "Recursos", "item": "{{ shop.url }}/pages/recursos" },
        { "@type": "ListItem", "position": 3, "name": "Armado en México" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Qué armas de fuego son legales para civiles en México?",
          "acceptedAnswer": { "@type": "Answer", "text": "Para civiles están permitidas pistolas hasta calibre .380 ACP, revólveres hasta .38 Special, rifles deportivos y de caza hasta calibres .30, y escopetas calibre 12. La adquisición se realiza en DCAM SEDENA con licencia previa." }
        },
        {
          "@type": "Question",
          "name": "¿Dónde se compran legalmente armas en México?",
          "acceptedAnswer": { "@type": "Answer", "text": "La única vía legal es la Dirección de Comercialización de Armamento y Municiones (DCAM) de SEDENA, con sedes en Campo Militar No. 1 (CDMX) y Monterrey. Se requiere licencia y registro previo." }
        },
        {
          "@type": "Question",
          "name": "¿{{ shop.name }} realiza el trámite SEDENA por mí?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Somos asesores, no gestores. Te orientamos sobre el proceso y resolvemos dudas legales con un abogado especializado, pero el trámite siempre lo realizas tú directamente ante la autoridad correspondiente." }
        }
      ]
    }
  ]
}
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ===== ARMADO MX — estilos scoped a #{{ sec_id }} ===== */
#armado-{{ sec_id }} {
  --amx-bg: {{ bg }};
  --amx-bg-elev: #161a14;
  --amx-bg-card: #1c211a;
  --amx-border: #2a2f24;
  --amx-amber: {{ accent }};
  --amx-military: #4a5d3a;
  --amx-red: #a83a2a;
  --amx-blue: #5a7a9a;
  --amx-text: #e8e6e0;
  --amx-text-dim: #a8a59c;
  --amx-text-muted: #6a685e;

  background: var(--amx-bg);
  color: var(--amx-text);
  font-family: 'JetBrains Mono', monospace;
  padding: 32px 0;
  position: relative;
  overflow: hidden;
}
#armado-{{ sec_id }} *, #armado-{{ sec_id }} *::before, #armado-{{ sec_id }} *::after {
  box-sizing: border-box;
}
#armado-{{ sec_id }}::before {
  content: ''; position: absolute; inset: 0;
  background-image:
    linear-gradient(rgba(201,162,39,0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(201,162,39,0.03) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
  mask-image: radial-gradient(ellipse at center, black 30%, transparent 80%);
}
#armado-{{ sec_id }} .amx-wrap {
  max-width: 1400px; margin: 0 auto;
  padding: 0 28px; position: relative;
}
#armado-{{ sec_id }} .amx-eyebrow {
  font-size: 11px; color: var(--amx-amber);
  letter-spacing: 0.2em; text-transform: uppercase;
  margin-bottom: 8px;
}
#armado-{{ sec_id }} .amx-h1 {
  font-family: 'Oswald', sans-serif;
  font-weight: 700; font-size: 38px;
  text-transform: uppercase;
  letter-spacing: 0.04em; line-height: 1;
  margin: 0 0 10px;
}
#armado-{{ sec_id }} .amx-h1 b { color: var(--amx-amber); font-weight: 700; }
#armado-{{ sec_id }} .amx-sub {
  font-size: 12px; color: var(--amx-text-dim);
  line-height: 1.6; max-width: 560px; margin-bottom: 24px;
}

/* Controls bar */
#armado-{{ sec_id }} .amx-controls {
  display: flex; flex-wrap: wrap; gap: 10px;
  align-items: center;
  background: var(--amx-bg-elev);
  border: 1px solid var(--amx-border);
  padding: 14px 16px; margin-bottom: 20px;
}
#armado-{{ sec_id }} .amx-search {
  display: flex; align-items: center; gap: 8px;
  background: var(--amx-bg); border: 1px solid var(--amx-border);
  padding: 8px 12px; flex: 1; min-width: 180px;
}
#armado-{{ sec_id }} .amx-search input {
  flex: 1; background: none; border: none; outline: none;
  color: var(--amx-text);
  font-family: 'JetBrains Mono', monospace; font-size: 12px;
}
#armado-{{ sec_id }} .amx-search input::placeholder { color: var(--amx-text-muted); }
#armado-{{ sec_id }} .amx-chips { display: flex; gap: 6px; flex-wrap: wrap; }
#armado-{{ sec_id }} .amx-chip {
  background: transparent; color: var(--amx-text-dim);
  border: 1px solid var(--amx-border);
  padding: 6px 12px; cursor: pointer;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase;
  transition: all 0.15s;
}
#armado-{{ sec_id }} .amx-chip:hover { color: var(--amx-text); border-color: var(--amx-amber); }
#armado-{{ sec_id }} .amx-chip.is-active {
  background: var(--amx-amber); color: #000; border-color: var(--amx-amber);
}

#armado-{{ sec_id }} .amx-rcount {
  margin-left: auto;
  font-size: 11px; color: var(--amx-text-dim);
  letter-spacing: 0.1em; text-transform: uppercase;
}

/* Grid */
#armado-{{ sec_id }} .amx-grid {
  display: grid; gap: 16px;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
}
#armado-{{ sec_id }} .amx-card {
  background: var(--amx-bg-card);
  border: 1px solid var(--amx-border);
  cursor: pointer; position: relative;
  transition: border-color 0.18s, transform 0.18s;
}
#armado-{{ sec_id }} .amx-card:hover {
  border-color: var(--amx-amber); transform: translateY(-2px);
}
/* tactical corners */
#armado-{{ sec_id }} .amx-card::before,
#armado-{{ sec_id }} .amx-card::after {
  content: ''; position: absolute; width: 8px; height: 8px;
  border-color: var(--amx-amber); pointer-events: none;
}
#armado-{{ sec_id }} .amx-card::before { top: 0; left: 0; border-top: 1.5px solid; border-left: 1.5px solid; }
#armado-{{ sec_id }} .amx-card::after { bottom: 0; right: 0; border-bottom: 1.5px solid; border-right: 1.5px solid; }
#armado-{{ sec_id }} .amx-card-img {
  height: 130px; display: flex; align-items: center; justify-content: center;
  background: radial-gradient(circle at 50% 50%, var(--amx-bg-elev) 0%, var(--amx-bg) 100%);
  border-bottom: 1px solid var(--amx-border);
  position: relative; overflow: hidden;
  transition: background 0.2s;
}
#armado-{{ sec_id }} .amx-card-img::before {
  content: ''; position: absolute; inset: 0;
  background-image: repeating-linear-gradient(0deg, transparent 0 3px, rgba(201,162,39,0.03) 3px 4px);
}
#armado-{{ sec_id }} .amx-card-img img {
  max-width: 88%; max-height: 88%; object-fit: contain;
  position: relative; z-index: 1;
  filter: grayscale(0.25) contrast(1.1);
}
/* Foto real → fondo blanco profesional, sin tramado */
#armado-{{ sec_id }} .amx-card-img.has-photo { background: #f4f1ea; }
#armado-{{ sec_id }} .amx-card-img.has-photo::before { background-image: none; }
#armado-{{ sec_id }} .amx-card-img.has-photo img { filter: none; max-width: 92%; max-height: 92%; }
#armado-{{ sec_id }} .amx-tag-tipo {
  position: absolute; top: 6px; left: 6px; z-index: 2;
  font-size: 8px; font-weight: 600;
  color: var(--amx-text-dim);
  background: rgba(0,0,0,0.6);
  padding: 2px 6px; letter-spacing: 0.1em;
  text-transform: uppercase;
  border-left: 2px solid var(--amx-amber);
}
#armado-{{ sec_id }} .amx-badge {
  position: absolute; top: 6px; right: 6px; z-index: 2;
  display: inline-flex; align-items: center; gap: 4px;
  padding: 2px 6px;
  background: rgba(0,0,0,0.55);
  font-size: 8px; font-weight: 600;
  letter-spacing: 0.08em; text-transform: uppercase;
  line-height: 1;
}
#armado-{{ sec_id }} .amx-badge.is-dcam      { color: var(--amx-military); border: 1px solid var(--amx-military); }
#armado-{{ sec_id }} .amx-badge.is-seguridad { color: var(--amx-amber);    border: 1px solid var(--amx-amber); }
#armado-{{ sec_id }} .amx-badge.is-ejercito  { color: var(--amx-red);      border: 1px solid var(--amx-red); }
#armado-{{ sec_id }} .amx-badge.is-externo   { color: var(--amx-blue);     border: 1px solid var(--amx-blue); }
#armado-{{ sec_id }} .amx-card-body { padding: 10px 12px; }
#armado-{{ sec_id }} .amx-card-brand {
  font-size: 9px; color: var(--amx-amber);
  letter-spacing: 0.12em; text-transform: uppercase;
  margin-bottom: 2px;
}
#armado-{{ sec_id }} .amx-card-name {
  font-family: 'Oswald', sans-serif;
  font-weight: 600; font-size: 15px;
  text-transform: uppercase; letter-spacing: 0.02em;
  line-height: 1.15; margin: 0 0 6px;
}
#armado-{{ sec_id }} .amx-card-specs {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 3px 8px; font-size: 9px;
  color: var(--amx-text-dim); margin-bottom: 8px;
}
#armado-{{ sec_id }} .amx-card-specs i { color: var(--amx-text-muted); font-style: normal; }
#armado-{{ sec_id }} .amx-card-bottom {
  display: flex; justify-content: space-between; align-items: center;
}
#armado-{{ sec_id }} .amx-stars {
  font-size: 10px; color: var(--amx-amber);
  letter-spacing: 0.1em; font-weight: 700;
}

/* Modal */
#armado-{{ sec_id }} .amx-modal-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(7,8,10,0.85);
  backdrop-filter: blur(6px);
  z-index: 9999;
  align-items: flex-start; justify-content: center;
  overflow-y: auto; padding: 40px 16px;
}
#armado-{{ sec_id }} .amx-modal-overlay.is-open { display: flex; }
#armado-{{ sec_id }} .amx-modal {
  background: var(--amx-bg-card);
  border: 1px solid var(--amx-amber);
  max-width: 900px; width: 100%;
  position: relative;
  box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(201,162,39,0.2);
}
#armado-{{ sec_id }} .amx-modal-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 24px;
  border-bottom: 1px solid var(--amx-border);
  background: var(--amx-bg-elev);
}
#armado-{{ sec_id }} .amx-modal-close {
  background: none; border: 1px solid var(--amx-border);
  color: var(--amx-text); cursor: pointer;
  width: 32px; height: 32px;
  font-size: 14px; line-height: 1;
}
#armado-{{ sec_id }} .amx-modal-close:hover { border-color: var(--amx-amber); color: var(--amx-amber); }
#armado-{{ sec_id }} .amx-modal-body {
  display: grid; grid-template-columns: 1fr 1fr; gap: 0;
}
@media (max-width: 720px) {
  #armado-{{ sec_id }} .amx-modal-body { grid-template-columns: 1fr; }
  #armado-{{ sec_id }} .amx-h1 { font-size: 28px; }
}
#armado-{{ sec_id }} .amx-modal-left {
  padding: 24px;
  background: radial-gradient(circle at 50% 40%, var(--amx-bg-elev) 0%, var(--amx-bg) 100%);
  border-right: 1px solid var(--amx-border);
  display: flex; flex-direction: column; gap: 14px;
  transition: background 0.2s;
}
#armado-{{ sec_id }} .amx-modal-left.has-photo { background: #f4f1ea; }
#armado-{{ sec_id }} .amx-modal-left img {
  max-width: 100%; max-height: 220px; object-fit: contain;
  margin: 0 auto;
  filter: grayscale(0.15) contrast(1.1) drop-shadow(0 4px 12px rgba(0,0,0,0.5));
}
#armado-{{ sec_id }} .amx-modal-left.has-photo img {
  filter: drop-shadow(0 4px 12px rgba(0,0,0,0.15));
}
#armado-{{ sec_id }} .amx-modal-right {
  padding: 24px; max-height: 70vh; overflow-y: auto;
}
#armado-{{ sec_id }} .amx-modal h2 {
  font-family: 'Oswald', sans-serif;
  font-size: 26px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.02em;
  line-height: 1.05; margin: 0 0 6px;
}
#armado-{{ sec_id }} .amx-sec-h {
  font-family: 'Oswald', sans-serif;
  font-size: 13px; font-weight: 600;
  text-transform: uppercase; letter-spacing: 0.15em;
  color: var(--amx-text); margin: 18px 0 10px;
  border-left: 3px solid var(--amx-amber); padding-left: 10px;
}
#armado-{{ sec_id }} .amx-spec-row {
  display: flex; justify-content: space-between;
  padding: 7px 10px; font-size: 11px;
  border-bottom: 1px solid var(--amx-border);
}
#armado-{{ sec_id }} .amx-spec-row .l {
  color: var(--amx-text-muted); text-transform: uppercase; letter-spacing: 0.08em; font-size: 10px;
}
#armado-{{ sec_id }} .amx-spec-row .v { color: var(--amx-text); font-weight: 600; }
#armado-{{ sec_id }} .amx-legal {
  padding: 12px 14px;
  border-left: 4px solid var(--amx-military);
  background: var(--amx-bg-elev);
  margin-bottom: 12px;
}
#armado-{{ sec_id }} .amx-legal.is-seguridad { border-color: var(--amx-amber); }
#armado-{{ sec_id }} .amx-legal.is-ejercito  { border-color: var(--amx-red); }
#armado-{{ sec_id }} .amx-legal-t {
  font-family: 'Oswald', sans-serif;
  font-weight: 700; font-size: 13px;
  text-transform: uppercase; letter-spacing: 0.08em;
  margin-bottom: 6px;
}
#armado-{{ sec_id }} .amx-legal-d {
  font-size: 11px; color: var(--amx-text-dim); line-height: 1.6;
}

/* Stats bars */
#armado-{{ sec_id }} .amx-stat { margin-bottom: 10px; }
#armado-{{ sec_id }} .amx-stat-l {
  display: flex; justify-content: space-between;
  font-size: 10px; color: var(--amx-text-dim);
  text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px;
}
#armado-{{ sec_id }} .amx-stat-l b { color: var(--amx-text); font-weight: 600; }
#armado-{{ sec_id }} .amx-stat-bar {
  height: 6px; background: var(--amx-bg);
  border: 1px solid var(--amx-border);
  position: relative; overflow: hidden;
}
#armado-{{ sec_id }} .amx-stat-fill {
  position: absolute; top: 0; bottom: 0; left: 0;
  background: linear-gradient(90deg, var(--amx-amber)aa, var(--amx-amber));
  box-shadow: 0 0 6px rgba(201,162,39,0.4);
}

/* WhatsApp CTA */
#armado-{{ sec_id }} .amx-wa-card {
  margin-top: 32px; padding: 20px;
  background: var(--amx-bg-card);
  border: 1.5px solid var(--amx-amber); position: relative;
}
#armado-{{ sec_id }} .amx-wa-card::before,
#armado-{{ sec_id }} .amx-wa-card::after {
  content: ''; position: absolute; width: 14px; height: 14px;
  border-color: var(--amx-amber);
}
#armado-{{ sec_id }} .amx-wa-card::before { top: 0; left: 0; border-top: 2px solid; border-left: 2px solid; }
#armado-{{ sec_id }} .amx-wa-card::after { bottom: 0; right: 0; border-bottom: 2px solid; border-right: 2px solid; }
#armado-{{ sec_id }} .amx-wa-h {
  font-family: 'Oswald', sans-serif;
  font-size: 18px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.04em;
  margin: 0 0 8px;
}
#armado-{{ sec_id }} .amx-wa-d {
  font-size: 11px; color: var(--amx-text-dim);
  line-height: 1.6; margin-bottom: 10px;
}
#armado-{{ sec_id }} .amx-wa-disc {
  font-size: 10px; color: var(--amx-text-muted);
  line-height: 1.6; margin: 0 0 16px;
  padding: 10px 12px;
  border-left: 2px solid var(--amx-amber);
  background: rgba(201,162,39,0.05);
}
#armado-{{ sec_id }} .amx-wa-disc b {
  color: var(--amx-amber); font-weight: 700; letter-spacing: 0.04em;
}
#armado-{{ sec_id }} .amx-wa-btn {
  display: inline-flex; justify-content: space-between; align-items: center;
  gap: 12px;
  background: var(--amx-amber); color: #000;
  text-decoration: none;
  padding: 12px 18px;
  font-family: 'Oswald', sans-serif; font-weight: 700; font-size: 13px;
  letter-spacing: 0.15em; text-transform: uppercase;
}
#armado-{{ sec_id }} .amx-wa-btn:hover { background: #d4a92e; }

/* Empty */
#armado-{{ sec_id }} .amx-empty {
  grid-column: 1/-1; text-align: center;
  padding: 60px 20px;
  font-size: 11px; color: var(--amx-text-muted);
}
</style>

<section id="armado-{{ sec_id }}" class="armado-mx">
  <div class="amx-wrap">
    {%- if section.settings.show_header -%}
      <div class="amx-eyebrow">◆ {{ section.settings.eyebrow | default: 'ENCICLOPEDIA TÁCTICA · 2026' }}</div>
      <h2 class="amx-h1">
        {{ section.settings.title_1 | default: 'ARMADO' }}<br>
        <b>{{ section.settings.title_2 | default: 'EN MÉXICO' }}</b>
      </h2>
      <p class="amx-sub">{{ section.settings.intro | default: 'Enciclopedia divulgativa de armas de fuego legales en México. Información técnica, histórica y legal para coleccionistas, deportistas y ciudadanos responsables.' }}</p>
    {%- endif -%}

    {%- comment -%} DATA — viene de metaobjects o JSON embebido en el setting {%- endcomment -%}
    <script id="amx-data-{{ sec_id }}" type="application/json">
    {%- if section.settings.data_source == 'metaobject' and shop.metaobjects.armado_arma.values.size > 0 -%}
      [
      {%- for arma in shop.metaobjects.armado_arma.values -%}
        {
          "id": {{ arma.system.id | json }},
          "nombre": {{ arma.nombre | json }},
          "marca": {{ arma.marca | json }},
          "tipo": {{ arma.tipo | json }},
          "pais": {{ arma.pais | json }},
          "calibre": {{ arma.calibre | json }},
          "capacidad": {{ arma.capacidad | json }},
          "peso": {{ arma.peso | json }},
          "longitud": {{ arma.longitud | json }},
          "mecanismo": {{ arma.mecanismo | json }},
          "anio": {{ arma.anio | default: 0 | json }},
          "era": {{ arma.era | json }},
          "avail": {{ arma.avail | json }},
          "availLabel": {{ arma.avail_label | json }},
          "legalTit": {{ arma.legal_titulo | json }},
          "legalDesc": {{ arma.legal_desc | json }},
          "historia": {{ arma.historia | json }},
          "priceExact": {{ arma.precio_exacto | json }},
          "priceLvl": {{ arma.precio_nivel | default: 1 | json }},
          "img": {{ arma.imagen | image_url: width: 640 | json }},
          "stats": {{ arma.stats | json }},
          "dcamRef": {{ arma.dcam_ref | json }},
          "disponibilidad": {{ arma.disponibilidad | json }},
          "uses": {{ arma.uses | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
      ]
    {%- else -%}
      {{ section.settings.fallback_json | default: '[]' }}
    {%- endif -%}
    </script>

    <div class="amx-controls">
      <div class="amx-search">
        <span style="color: var(--amx-amber);">⌕</span>
        <input id="amx-search-{{ sec_id }}" type="text" placeholder="Nombre, marca, calibre, país...">
      </div>
      <div class="amx-chips" data-filter-group="tipo">
        <button class="amx-chip is-active" data-value="all">Todas</button>
        <button class="amx-chip" data-value="pistola">Pistolas</button>
        <button class="amx-chip" data-value="revolver">Revólveres</button>
        <button class="amx-chip" data-value="rifle">Rifles</button>
        <button class="amx-chip" data-value="escopeta">Escopetas</button>
        <button class="amx-chip" data-value="carabina">Carabinas</button>
      </div>
      <div class="amx-chips" data-filter-group="avail">
        <button class="amx-chip is-active" data-value="all">Toda Legal</button>
        <button class="amx-chip" data-value="dcam">Civil DCAM</button>
        <button class="amx-chip" data-value="seguridad">Seguridad</button>
        <button class="amx-chip" data-value="ejercito">Ejército</button>
      </div>
      <div class="amx-rcount" id="amx-count-{{ sec_id }}">▸ 0 ARMAS</div>
    </div>

    <div class="amx-grid" id="amx-grid-{{ sec_id }}"></div>

    {%- if section.settings.show_legal -%}
      <div class="amx-wa-card">
        <div class="amx-eyebrow">▸ ASESORÍA LEGAL CON ABOGADO</div>
        <h3 class="amx-wa-h">{{ section.settings.legal_title | default: '¿Dudas sobre la Ley Federal de Armas de Fuego?' }}</h3>
        <p class="amx-wa-d">{{ section.settings.legal_pitch | default: 'Te orientamos sobre el proceso de adquisición legal ante SEDENA y resolvemos dudas con un abogado especializado en la Ley Federal de Armas de Fuego y Explosivos.' }}</p>
        <p class="amx-wa-disc"><b>Somos asesores, no gestores.</b> {{ section.settings.legal_disclaimer | default: 'El trámite, la solicitud y la entrega se realizan directamente entre tú y la autoridad. No representamos ni intermediamos ante SEDENA.' }}</p>
        <a class="amx-wa-btn"
           href="https://wa.me/{{ wa_phone }}?text={{ wa_msg | url_encode }}"
           target="_blank" rel="noopener">
          <span>{{ section.settings.wa_btn_text | default: 'WhatsApp · Hablar con un asesor' }}</span>
          <span style="font-size: 16px;">↗</span>
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} MODAL {%- endcomment -%}
  <div class="amx-modal-overlay" id="amx-modal-{{ sec_id }}">
    <div class="amx-modal">
      <div class="amx-modal-head">
        <div>
          <div class="amx-eyebrow" id="amx-m-brand"></div>
          <h2 id="amx-m-name"></h2>
        </div>
        <button class="amx-modal-close" onclick="document.getElementById('amx-modal-{{ sec_id }}').classList.remove('is-open');">✕</button>
      </div>
      <div class="amx-modal-body">
        <div class="amx-modal-left">
          <img id="amx-m-img" src="data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%2F%3E" alt="">
          <div id="amx-m-badges"></div>
        </div>
        <div class="amx-modal-right" id="amx-m-content"></div>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  const sec = document.getElementById('armado-{{ sec_id }}');
  if (!sec) return;
  const DATA = JSON.parse(document.getElementById('amx-data-{{ sec_id }}').textContent || '[]');

  const state = { q: '', tipo: 'all', avail: 'all' };

  const placeholder = function(a) {
    const map = {
      pistola:'M30,55L30,45L90,45L90,30L140,30L140,45L175,45L180,50L180,60L140,60L140,75L100,75L90,65L30,65Z',
      revolver:'M30,55L30,45L80,45L90,35L110,35L120,45L175,45L180,50L180,60L140,60L140,75L100,75L95,65L30,65Z',
      rifle:'M20,52L20,48L80,48L90,42L120,42L130,48L270,48L280,50L290,50L290,58L280,58L130,58L120,62L90,62L80,58L20,58Z',
      escopeta:'M20,52L20,48L80,48L90,42L130,42L140,48L290,48L300,50L300,58L290,58L140,58L130,62L90,62L80,58L20,58Z',
      carabina:'M30,52L30,46L90,46L100,40L130,40L140,46L250,46L260,48L270,48L270,60L260,60L140,60L130,64L100,64L90,60L30,60Z',
    };
    const p = map[a.tipo] || map.pistola;
    const svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 90'><defs><pattern id='s' patternUnits='userSpaceOnUse' width='6' height='6' patternTransform='rotate(45)'><line x1='0' y1='0' x2='0' y2='6' stroke='#c9a227' stroke-width='2' opacity='0.18'/></pattern></defs><path d='"+p+"' fill='url(#s)' stroke='#c9a227' stroke-width='1.2' opacity='0.9'/><text x='160' y='86' font-family='monospace' font-size='6' fill='#6a685e' text-anchor='middle' letter-spacing='2'>"+(a.marca||'').toUpperCase()+" · "+(a.tipo||'').toUpperCase()+"</text></svg>";
    return 'data:image/svg+xml;utf8,' + svg.replace(/#/g, '%23');
  };

  function stars(n) { return '$'.repeat(n||1) + '·'.repeat(5-(n||1)); }

  function filtered() {
    return DATA.filter(a => {
      if (state.tipo !== 'all' && a.tipo !== state.tipo) return false;
      if (state.avail !== 'all' && a.avail !== state.avail) return false;
      if (state.q) {
        const q = state.q.toLowerCase();
        if (!(a.nombre||'').toLowerCase().includes(q) &&
            !(a.marca||'').toLowerCase().includes(q) &&
            !(a.calibre||'').toLowerCase().includes(q) &&
            !(a.pais||'').toLowerCase().includes(q)) return false;
      }
      return true;
    });
  }

  function render() {
    const arms = filtered();
    const grid = document.getElementById('amx-grid-{{ sec_id }}');
    document.getElementById('amx-count-{{ sec_id }}').textContent = '▸ ' + arms.length + ' ' + (arms.length === 1 ? 'ARMA' : 'ARMAS');
    if (!arms.length) {
      grid.innerHTML = '<div class="amx-empty">Sin resultados. Ajusta los filtros.</div>';
      return;
    }
    grid.innerHTML = arms.map(a => {
      const fb = placeholder(a);
      const img = a.img || fb;
      const isReal = img && img.indexOf('http') === 0;
      return '<div class="amx-card" onclick="window.__amxOpen_{{ sec_id }}('+a.id+')">' +
        '<div class="amx-card-img'+(isReal?' has-photo':'')+'">' +
          '<span class="amx-tag-tipo">'+(a.tipo||'').toUpperCase()+'</span>' +
          '<span class="amx-badge is-'+(a.avail||'dcam')+'">'+(a.availLabel||'Civil')+'</span>' +
          '<img src="'+img+'" alt="'+a.nombre+'" loading="lazy" onerror="this.src=\''+fb+'\'; this.onerror=null; var p=this.closest(\'.amx-card-img\'); if(p)p.classList.remove(\'has-photo\');">' +
        '</div>' +
        '<div class="amx-card-body">' +
          '<div class="amx-card-brand">'+(a.marca||'')+' · '+(a.pais||'')+'</div>' +
          '<div class="amx-card-name">'+(a.nombre||'')+'</div>' +
          '<div class="amx-card-specs"><div><i>CAL </i>'+(a.calibre||'')+'</div><div><i>CAP </i>'+(a.capacidad||'')+'</div></div>' +
          '<div class="amx-card-bottom">' +
            '<span style="font-size:9px;color:var(--amx-text-muted);letter-spacing:0.1em;">'+(a.tipo||'').toUpperCase()+'</span>' +
            '<span class="amx-stars">'+stars(a.priceLvl)+'</span>' +
          '</div>' +
        '</div>' +
      '</div>';
    }).join('');
  }

  window.__amxOpen_{{ sec_id }} = function(id) {
    const a = DATA.find(x => x.id === id || String(x.id) === String(id));
    if (!a) return;
    document.getElementById('amx-m-brand').textContent = (a.marca||'') + ' · ' + (a.pais||'') + ' · ' + (a.anio||'');
    document.getElementById('amx-m-name').textContent = a.nombre;
    const fb = placeholder(a);
    const img = document.getElementById('amx-m-img');
    const src = a.img || fb;
    const isReal = src && src.indexOf('http') === 0;
    img.src = src;
    img.parentElement.classList.toggle('has-photo', !!isReal);
    img.onerror = () => { img.src = fb; img.onerror = null; img.parentElement.classList.remove('has-photo'); };

    document.getElementById('amx-m-badges').innerHTML =
      '<span class="amx-badge is-'+(a.avail||'dcam')+'" style="display:block;text-align:center;padding:8px;font-size:10px;">'+(a.availLabel||'')+'</span>' +
      '<div style="margin-top:10px;padding:12px;background:rgba(0,0,0,0.4);border:1px solid var(--amx-border);font-size:10px;color:var(--amx-text-muted);line-height:1.6;">' +
        '<div style="color:var(--amx-amber);font-weight:700;letter-spacing:0.15em;margin-bottom:4px;font-size:9px;">◆ PRECIO DCAM</div>' +
        '<div style="color:var(--amx-text);font-family:Oswald,sans-serif;font-weight:700;font-size:16px;">'+(a.priceExact||'Sin información')+'</div>' +
      '</div>';

    let content = '';
    content += '<div class="amx-sec-h">Especificaciones</div>';
    [['Calibre', a.calibre], ['Capacidad', a.capacidad], ['Peso', a.peso], ['Longitud', a.longitud],
     ['Mecanismo', a.mecanismo], ['Origen', a.pais], ['Año', a.anio]].forEach(([l, v]) => {
      content += '<div class="amx-spec-row"><span class="l">'+l+'</span><span class="v">'+(v||'—')+'</span></div>';
    });
    if (a.stats) {
      content += '<div class="amx-sec-h">Estadísticas</div>';
      [['alcance','Alcance'],['precision','Precisión'],['retroceso','Retroceso'],['capacidad','Capacidad'],['manejo','Manejo'],['poder','Poder']].forEach(([k, l]) => {
        const v = a.stats[k] || 0;
        content += '<div class="amx-stat"><div class="amx-stat-l"><span>'+l+'</span><b>'+v+'</b></div><div class="amx-stat-bar"><div class="amx-stat-fill" style="width:'+v+'%"></div></div></div>';
      });
    }
    content += '<div class="amx-sec-h">Estatus Legal</div>';
    content += '<div class="amx-legal is-'+(a.avail||'dcam')+'"><div class="amx-legal-t">'+(a.legalTit||'')+'</div><div class="amx-legal-d">'+(a.legalDesc||'')+'</div></div>';
    if (a.historia) {
      content += '<div class="amx-sec-h">Historia</div>';
      content += '<div style="font-size:11px;color:var(--amx-text-dim);line-height:1.7;padding:12px;background:var(--amx-bg-elev);border:1px solid var(--amx-border);">'+a.historia+'</div>';
    }
    document.getElementById('amx-m-content').innerHTML = content;
    document.getElementById('amx-modal-{{ sec_id }}').classList.add('is-open');
  };

  // overlay click cierra
  document.getElementById('amx-modal-{{ sec_id }}').addEventListener('click', function(e) {
    if (e.target === this) this.classList.remove('is-open');
  });

  // listeners
  document.getElementById('amx-search-{{ sec_id }}').addEventListener('input', (e) => {
    state.q = e.target.value;
    render();
  });
  sec.querySelectorAll('.amx-chips').forEach(group => {
    const key = group.getAttribute('data-filter-group');
    group.addEventListener('click', (e) => {
      const chip = e.target.closest('.amx-chip');
      if (!chip) return;
      group.querySelectorAll('.amx-chip').forEach(c => c.classList.remove('is-active'));
      chip.classList.add('is-active');
      state[key] = chip.getAttribute('data-value');
      render();
    });
  });

  render();
})();
</script>

{% schema %}
{
  "name": "Armado en México",
  "tag": "section",
  "class": "section-armado-mx",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Mostrar título / intro",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ENCICLOPEDIA TÁCTICA · 2026"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Título línea 1",
      "default": "ARMADO"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Título línea 2 (acento)",
      "default": "EN MÉXICO"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introducción"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "color_bg",
      "label": "Fondo",
      "default": "#0d0f0c"
    },
    {
      "type": "color",
      "id": "color_accent",
      "label": "Acento (ámbar)",
      "default": "#c9a227"
    },
    {
      "type": "header",
      "content": "Fuente de datos"
    },
    {
      "type": "select",
      "id": "data_source",
      "label": "De dónde leer las armas",
      "options": [
        { "value": "metaobject", "label": "Metaobjects 'armado_arma'" },
        { "value": "manual",     "label": "JSON manual (abajo)" }
      ],
      "default": "manual"
    },
    {
      "type": "textarea",
      "id": "fallback_json",
      "label": "Catálogo JSON (si no usas metaobjects)",
      "info": "Array de armas en JSON. Ver documentación en el archivo de la sección."
    },
    {
      "type": "header",
      "content": "Asesoría WhatsApp"
    },
    {
      "type": "checkbox",
      "id": "show_legal",
      "label": "Mostrar tarjeta de asesoría WhatsApp",
      "default": true
    },
    {
      "type": "text",
      "id": "whatsapp_phone",
      "label": "WhatsApp (con código país)",
      "default": "525555555555"
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Mensaje predefinido",
      "default": "Hola, tengo una duda sobre la Ley Federal de Armas de Fuego"
    },
    {
      "type": "text",
      "id": "legal_title",
      "label": "Título de la asesoría",
      "default": "¿Dudas sobre la Ley Federal de Armas de Fuego?"
    },
    {
      "type": "textarea",
      "id": "legal_pitch",
      "label": "Texto de la asesoría"
    },
    {
      "type": "textarea",
      "id": "legal_disclaimer",
      "label": "Disclaimer 'asesores no gestores'",
      "info": "Aparece después de la frase fija 'Somos asesores, no gestores.'"
    },
    {
      "type": "text",
      "id": "wa_btn_text",
      "label": "Texto del botón WhatsApp",
      "default": "WhatsApp · Hablar con un asesor"
    }
  ],
  "presets": [
    {
      "name": "Armado en México — Catálogo"
    }
  ]
}
{% endschema %}
